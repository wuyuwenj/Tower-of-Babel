# ============================================================================
# Tower of Babel — environment
#
# IMPORTANT: the three generation API keys are SERVER-SIDE ONLY. They must live
# in Convex, never in this file's committed form and never in a VITE_ var
# (anything prefixed VITE_ is bundled into the browser and is public).
#
# Set them with:
#   npx convex env set WORLDLABS_API_KEY   ...
#   npx convex env set TRIPO_API_KEY       ...
#   npx convex env list          # verify
#
# Keep them here too so they are easy to re-paste; .env is gitignored.
# ============================================================================

# --- Server-side (set in Convex, mirrored here for convenience) -------------

# OpenAI — OPTIONAL. Only rewrites flavor text (theme name, prompts, card names).
# The level still composes fine without it: convex/composer.ts is a deterministic
# hand-authored table, and enrich() falls back to it on any error. Nothing about
# gameplay balance ever comes from a model.
#   npx convex env set OPENAI_API_KEY sk-...
#   npx convex env set OPENAI_MODEL gpt-5.6-luna      # optional, this is the default
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Mint — PRIMARY provider. One key covers the whole forge:
#   worlds:generate -> SPZ splat + collider mesh (what Spark and Rapier need)
#   models:generate -> GLB creatures/monuments (and FBX, which imports to Roblox)
# Redeem SPATIAL at https://mint.gg/account
#   npx convex env set MINT_API_KEY ...
MINT_API_KEY=

# --- Alternate providers (only used when MINT_API_KEY is absent) ------------

# World Labs Marble — worlds. Redeem WORLD-MODEL-HACK-API at platform.worldlabs.ai
WORLDLABS_API_KEY=

# Tripo — creature/monument models. https://platform.tripo3d.ai/api-keys
TRIPO_API_KEY=

# --- Client-side (safe to expose; written by `npx convex dev`) --------------

# Convex deployment URL, e.g. https://acoustic-panda-123.convex.cloud
VITE_CONVEX_URL=

# --- Optional overrides -----------------------------------------------------

# Splat used for level 1 before anything has been forged.
VITE_SEED_SPLAT_URL=https://storage.googleapis.com/forge-dev-public/hackathon-260227/haunted-house.spz
